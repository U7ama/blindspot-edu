[Unit]
Description=Blindspot API
After=network-online.target
[Service]
User=blindspot
Group=blindspot
WorkingDirectory=/opt/blindspot
EnvironmentFile=/etc/blindspot.env
ExecStart=/opt/blindspot/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/blindspot
MemoryMax=1200M
[Install]
WantedBy=multi-user.target
