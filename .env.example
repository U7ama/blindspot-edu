# Local configuration, aligned with the working development setup (September 30).
# Copy to .env only for a fresh setup; merge settings into an existing .env.
# Supply your own compatible endpoint, API key, and private invitation code.
# This file contains no working credentials. Do not copy private .env into a release.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
DATA_DIR=./backend/private_data
DATABASE_URL=sqlite:///./blindspot.db
PILOT_INVITE_CODE=
STORAGE_BACKEND=local
S3_BUCKET_NAME=
AWS_REGION=us-east-1

# Active reasoning provider. Use the endpoint supplied by your Model Studio workspace.
LLM_PROVIDER=modelstudio
LLM_MODEL=qwen3.7-flash
LLM_BASE_URL=https://YOUR_WORKSPACE.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_TIMEOUT=300
# Additional application retries; the compatible SDK's own retries are disabled.
LLM_MAX_RETRIES=3
# Explicit cross-model reuse, matching the current development configuration.
# Leave empty to restrict reuse to the active model; only reuse trusted saved output.
LLM_CACHE_INHERIT_MODELS=qwen3.7-max,qwen3.7-plus,kimi-k3

# Bedrock adapter is inactive. AWS did not approve this account's requested access
# at this time. Supply an account-verified ID before switching LLM_PROVIDER=bedrock.
BEDROCK_MODEL_ID=

# Local text + browser speech; production uses TTS_PROVIDER=polly with an EC2 role.
TTS_PROVIDER=disabled
WHISPER_MODEL=base
WHISPER_CPU_THREADS=4

# Current development limits: 250 MiB and 120 minutes, not performance guarantees.
# Caddy/Next.js proxy ceilings must match; production may intentionally allow less.
MAX_UPLOAD_BYTES=262144000
MAX_DURATION_SECONDS=7200
MAX_RECORDINGS_PER_LEARNER=50

# Development generation allowances raised to let complete lessons finish.
# Cumulative local estimates across LLM/Polly usage, NOT AWS credits or billing caps.
# These exceed the $50 AWS budget. Set deployment-specific allowances before launch;
# review usage before resetting totals, and verify prices for the actual provider.
AI_TOTAL_ALLOWANCE_USD=500
AI_LEARNER_ALLOWANCE_USD=100
AI_DAILY_CALL_LIMIT=2000
LLM_INPUT_USD_PER_MILLION=0.10
LLM_OUTPUT_USD_PER_MILLION=0.50
POLLY_USD_PER_MILLION_CHARS=16

# YouTube imports may still be restricted by the source; account cookies are optional.
YOUTUBE_IMPORT_TIMEOUT_SECONDS=600
YOUTUBE_USE_ACCOUNT_COOKIES=false
# YOUTUBE_COOKIES_FILE=/var/lib/blindspot/youtube_cookies.txt

# Optional completion email; production uses ses with a verified domain/sender.
NOTIFICATION_EMAIL_PROVIDER=disabled
SES_REGION=us-east-1
SES_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
PUBLIC_APP_URL=
# For local SES testing only: APP_ENV=development and PUBLIC_APP_URL=http://localhost:3000.
# Production email links require HTTPS. Configure a verified SES sender before enabling ses.

# Production overrides (in the private host environment, not committed here):
# APP_ENV=production
# APP_ORIGIN=https://YOUR_HOSTNAME
# PUBLIC_APP_URL=https://YOUR_HOSTNAME
# DATA_DIR=/var/lib/blindspot/private
# DATABASE_URL=sqlite:////var/lib/blindspot/blindspot.db
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=YOUR_STACK_MEDIA_BUCKET
# TTS_PROVIDER=polly
# NOTIFICATION_EMAIL_PROVIDER=ses
# SES_FROM_EMAIL=notifications@YOUR_VERIFIED_DOMAIN
# SES_REPLY_TO_EMAIL=YOUR_WORKING_SUPPORT_INBOX
# HF_HOME=/var/lib/blindspot/models
# Use an EC2 instance role; do not add AWS access keys to this example.

# Optional R2 adapter, used only with STORAGE_BACKEND=r2.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_KEY=
