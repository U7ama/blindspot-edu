# Local defaults; copy to .env. Never commit credentials or invitation codes.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
DATA_DIR=./backend/private_data
DATABASE_URL=sqlite:///./blindspot.db
PILOT_INVITE_CODE=
STORAGE_BACKEND=local
S3_BUCKET_NAME=
AWS_REGION=us-east-1
# Production uses an EC2 role. Do not place AWS keys here.
LLM_PROVIDER=bedrock
# Discovered in the configured account; deployment must confirm continued access.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Explicit rollback provider only; not used by Bedrock.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
TTS_PROVIDER=polly
WHISPER_MODEL=base
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=3600
MAX_RECORDINGS_PER_LEARNER=3
AI_TOTAL_ALLOWANCE_USD=6
AI_LEARNER_ALLOWANCE_USD=1
AI_DAILY_CALL_LIMIT=100
# Conservative reservations, not a price quote. Verify rates for selected model.
LLM_INPUT_USD_PER_MILLION=1
LLM_OUTPUT_USD_PER_MILLION=8
POLLY_USD_PER_MILLION_CHARS=16
# R2 only when explicitly selected:
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_KEY=

# Qwen alternative: set LLM_PROVIDER=qwen and supply your own key.
# LLM_MODEL=qwen3.7-flash
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# TTS_PROVIDER=disabled  # Text-only when AWS Polly is unavailable.

# Alibaba Model Studio alternative (same compatible adapter):
# LLM_PROVIDER=modelstudio
# LLM_MODEL=kimi-k3
# LLM_BASE_URL=https://YOUR_WORKSPACE.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# LLM_INPUT_USD_PER_MILLION=3
# LLM_OUTPUT_USD_PER_MILLION=15

# YouTube extraction, download and merge deadline (seconds; 30–1800).
YOUTUBE_IMPORT_TIMEOUT_SECONDS=600
# Optional, explicit cross-model cache reuse. Empty disables inheritance.
# Existing Qwen 3.7 Plus continuation defaults to kimi-k3 when unset.
# LLM_CACHE_INHERIT_MODELS=kimi-k3

# Completion email is disabled until a verified SES sender is configured.
NOTIFICATION_EMAIL_PROVIDER=disabled
SES_REGION=us-east-1
SES_FROM_EMAIL=
PUBLIC_APP_URL=
